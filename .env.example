# --- API keys ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which provider the red/blue AGENTS reason with. "anthropic" or "openai".
LLM_PROVIDER=anthropic

# The VICTIM app can run on a separate, more-injectable model than the agents
# (realistic: many production apps ship on gpt-4o-mini). Leave blank to use the
# same provider as the agents. Set to "openai" for reliable prompt-injection demos.
VICTIM_PROVIDER=openai

# --- optional Decart live camera ---
DECART_API_KEY=
ENABLE_DECART=false

PORT=3000
